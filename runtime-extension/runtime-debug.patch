+absl::StatusOr<std::string> LlmLiteRtNpuCompiledModelExecutor::GetGhostDebugJson(const std::string& request) const {
+  using Json=nlohmann::ordered_json;
+  const auto query=Json::parse(request,nullptr,false);
+  if(query.is_discarded()||!query.is_object())return absl::InvalidArgumentError("Invalid debug request.");
+  const int selected_layer=query.value("layer",-1), selected_slot=query.value("slot",-1), fd=query.value("fd",-1);
+  const std::string format=query.value("format",std::string("inspect"));
+  const bool token_csv=format=="tokens_csv", kv_csv=format=="kv_csv", kv_raw=format=="kv_raw";
+  if(format!="inspect"&&!token_csv&&!kv_csv&&!kv_raw)return absl::InvalidArgumentError("Unsupported export format.");
+  if((token_csv||kv_csv||kv_raw)&&fd<0)return absl::InvalidArgumentError("An export file is required.");
+  if(selected_layer<-1||selected_slot<-1)return absl::InvalidArgumentError("Invalid layer or slot.");
+  auto write_bytes=[&](const void* data,size_t size)->absl::Status {
+    const char* bytes=static_cast<const char*>(data);
+    while(size){ssize_t count=::write(fd,bytes,size);if(count<0&&errno==EINTR)continue;
+      if(count<=0)return absl::InternalError("Could not write the export file.");bytes+=count;size-=count;}
+    return absl::OkStatus();
+  };
+  auto address=[](const void* pointer){std::ostringstream out;out<<"0x"<<std::hex<<reinterpret_cast<uintptr_t>(pointer);return out.str();};
+  auto hex=[](const unsigned char* data,size_t size){std::string out;out.reserve(size*2);static const char digits[]="0123456789abcdef";
+    for(size_t i=0;i<size;++i){out.push_back(digits[data[i]>>4]);out.push_back(digits[data[i]&15]);}return out;};
+  const auto views=processed_tokens_.GhostStorageViews();
+  const bool pending=!views.empty()&&views[0].pending_id;
+  const int valid=std::max(0,current_step_-(pending?1:0));
+  const auto& group=ActiveContextGroup();
+  const auto stamp=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+  Json out={{"backend","NPU"},{"step",current_step_},{"kv_positions",valid},{"capture_ns",stamp},
+            {"context_size",group.context_size},{"ringbuffer",group.geometry.uses_ringbuffer},
+            {"source","Live process-owned memory; no retokenization or historical capture"}};
+  if(selected_layer<0&&!kv_csv&&!kv_raw){
+    out["tokens"]=Json::array();out["token_allocations"]=Json::array();
+    if(token_csv){const std::string header="capture_ns,candidate,index,region,address,byte_offset,id_int32,raw_hex_le\n";LITERT_RETURN_IF_ERROR(write_bytes(header.data(),header.size()));}
+    for(size_t candidate=0;candidate<views.size();++candidate){
+      const auto& view=views[candidate];
+      out["token_allocations"].push_back({{"candidate",candidate},{"size",view.size},{"capacity",view.capacity},{"address",address(view.data)}});
+      for(size_t i=0;i<view.capacity+(view.pending_id?1:0);++i){
+        const bool is_pending=i==view.capacity;const size_t position=is_pending?view.size:i;
+        const auto* data=reinterpret_cast<const unsigned char*>(is_pending?view.pending_id:view.data+i);
+        int32_t id;std::memcpy(&id,data,sizeof(id));const std::string raw=hex(data,sizeof(id));
+        const std::string region=is_pending?"pending":(i<view.size?"live":"spare");
+        if(token_csv){std::string row=std::to_string(stamp)+","+std::to_string(candidate)+","+std::to_string(position)+","+region+","+address(data)+","+(is_pending?"":std::to_string(i*sizeof(int)))+","+std::to_string(id)+","+raw+"\n";LITERT_RETURN_IF_ERROR(write_bytes(row.data(),row.size()));}
+        else out["tokens"].push_back({{"candidate",candidate},{"index",position},{"region",region},{"address",address(data)},
+              {"byte_offset",is_pending?-1:static_cast<int64_t>(i*sizeof(int))},{"id",id},{"raw_hex",raw}});
+      }
+    }
+    if(token_csv)return Json({{"exported",true},{"format",format},{"capture_ns",stamp}}).dump();
+  }
+  struct BufferView {int layer;std::string name;const ::litert::TensorBuffer* buffer;Json meta;};
+  std::vector<BufferView> buffers;
+  std::map<int,Json> layers;
+  size_t payload_offset=0;
+  for(const auto& entry:group.input_kv_cache_buffers){
+    const std::string name(entry.first);const auto suffix=name.rfind('_');int layer=-1;
+    if(suffix==std::string::npos||!absl::SimpleAtoi(name.substr(suffix+1),&layer))continue;
+    if(selected_layer>=0&&layer!=selected_layer)continue;
+    const auto& buffer=entry.second;auto type=buffer.TensorType();auto packed=buffer.PackedSize();auto size=buffer.Size();auto offset=buffer.Offset();
+    if(!type.HasValue()||!packed.HasValue()||!size.HasValue()||!offset.HasValue())return absl::InternalError("Cache buffer metadata is unavailable.");
+    // Offset views need backend-specific allocation bounds; never guess/read out of range.
+    if(*offset!=0)return absl::UnimplementedError("Non-zero-offset KV views are not supported by this inspector.");
+    const auto dims=type->Layout().Dimensions();std::vector<size_t> strides(dims.size(),1);size_t elements=1;
+    for(int d=static_cast<int>(dims.size())-1;d>=0;--d){strides[d]=elements;if(dims[d]<=0)return absl::InternalError("Invalid KV dimensions.");elements*=dims[d];}
+    if(type->Layout().HasStrides()){auto declared=type->Layout().Strides();for(size_t d=0;d<dims.size();++d)strides[d]=declared[d];}
+    const size_t width=elements?*packed/elements:0;if(!width)return absl::InternalError("Invalid KV element width.");
+    auto info=group.geometry.kv_buffer_info.find(name);int axis=info==group.geometry.kv_buffer_info.end()?-1:info->second.sequence_axis;
+    bool local=info!=group.geometry.kv_buffer_info.end()&&info->second.is_local;
+    std::string dtype="raw";switch(type->ElementType()){
+      case litert::ElementType::Int8:dtype="int8";break;case litert::ElementType::UInt8:dtype="uint8";break;
+      case litert::ElementType::Int16:dtype="int16";break;case litert::ElementType::Int32:dtype="int32";break;
+      case litert::ElementType::Float16:dtype="float16";break;case litert::ElementType::Float32:dtype="float32";break;default:break;}
+    Json tensor={{"name",name},{"allocated_bytes",*size},{"packed_bytes",*packed},{"tensor_offset",*offset},
+        {"shape",Json::array()},{"strides",strides},{"element_bytes",width},{"dtype",dtype},
+        {"sequence_axis",axis},{"local",local},{"payload_offset",payload_offset}};
+    for(auto d:dims)tensor["shape"].push_back(d);payload_offset+=*size;
+    const int capacity=axis>=0&&axis<dims.size()?dims[axis]:0;tensor["capacity"]=capacity;tensor["active_slots"]=std::min(valid,capacity);
+    buffers.push_back({layer,name,&buffer,tensor});
+  }
+  std::sort(buffers.begin(),buffers.end(),[](const BufferView& a,const BufferView& b){return a.layer==b.layer?a.name<b.name:a.layer<b.layer;});
+  payload_offset=0;for(auto& buffer:buffers){buffer.meta["payload_offset"]=payload_offset;payload_offset+=buffer.meta["allocated_bytes"].get<size_t>();}
+  if(kv_raw){
+    Json manifest=out;manifest["format"]="GHOSTKV1";manifest["byte_order"]="little-endian";manifest["buffers"]=Json::array();
+    for(const auto& b:buffers){auto meta=b.meta;meta["layer"]=b.layer;manifest["buffers"].push_back(meta);}
+    const std::string header=manifest.dump();uint64_t length=header.size();unsigned char length_le[8];for(int i=0;i<8;++i)length_le[i]=(length>>(i*8))&255;
+    LITERT_RETURN_IF_ERROR(write_bytes("GHOSTKV1",8));LITERT_RETURN_IF_ERROR(write_bytes(length_le,8));LITERT_RETURN_IF_ERROR(write_bytes(header.data(),header.size()));
+    for(const auto& b:buffers){auto lock=::litert::TensorBufferScopedLock::Create(*b.buffer,::litert::TensorBuffer::LockMode::kRead);
+      if(!lock.HasValue())return absl::InternalError("KV buffer mapping failed.");LITERT_RETURN_IF_ERROR(write_bytes(lock->second,b.meta["allocated_bytes"].get<size_t>()));}
+    return Json({{"exported",true},{"format",format},{"capture_ns",stamp},{"bytes",payload_offset+16+header.size()}}).dump();
+  }
+  if(kv_csv){std::string header="capture_ns,layer,buffer,dtype,shape,sequence_axis,slot,logical_position,active,address,first_byte_offset,raw_hex_le\n";LITERT_RETURN_IF_ERROR(write_bytes(header.data(),header.size()));}
+  for(auto& b:buffers){
+    Json tensor=b.meta;const int axis=tensor["sequence_axis"],capacity=tensor["capacity"];const bool local=tensor["local"];
+    if((selected_layer>=0||kv_csv)&&capacity>0){
+      auto lock=::litert::TensorBufferScopedLock::Create(*b.buffer,::litert::TensorBuffer::LockMode::kRead);
+      if(!lock.HasValue())return absl::InternalError("KV buffer mapping failed.");
+      const auto* bytes=static_cast<const unsigned char*>(lock->second);tensor["address"]=address(bytes);
+      const auto dims=tensor["shape"].get<std::vector<size_t>>(), strides=tensor["strides"].get<std::vector<size_t>>();
+      const size_t width=tensor["element_bytes"],size=tensor["allocated_bytes"];size_t count=1;for(size_t d=0;d<dims.size();++d)if(d!=axis)count*=dims[d];
+      tensor["samples"]=Json::array();
+      for(int slot=0;slot<capacity;++slot){
+        const bool active=slot<std::min(valid,capacity);int position=slot;
+        if(local&&group.geometry.uses_ringbuffer&&valid>capacity){position=(valid/capacity)*capacity+slot;if(position>=valid)position-=capacity;}
+        std::string raw;bool zero=true;Json offsets=Json::array();const bool full=kv_csv||selected_slot==slot;const size_t wanted=full?count:std::min(count,static_cast<size_t>(16/width));
+        for(size_t component=0;component<wanted;++component){size_t flat=component,element=slot*strides[axis];
+          for(int d=static_cast<int>(dims.size())-1;d>=0;--d)if(d!=axis){element+=(flat%dims[d])*strides[d];flat/=dims[d];}
+          const size_t offset=element*width;if(offset+width>size)return absl::InternalError("KV layout exceeds mapped allocation.");
+          raw+=hex(bytes+offset,width);for(size_t i=0;i<width;++i)zero&=bytes[offset+i]==0;
