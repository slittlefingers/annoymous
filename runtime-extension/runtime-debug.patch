+        }
+        if(kv_csv){std::string shape;for(auto dim:dims){if(!shape.empty())shape+='x';shape+=std::to_string(dim);}
+          std::string row=std::to_string(stamp)+","+std::to_string(b.layer)+","+b.name+","+tensor["dtype"].get<std::string>()+","+shape+","+std::to_string(axis)+","+std::to_string(slot)+","+std::to_string(active?position:-1)+","+(active?"1":"0")+","+address(bytes)+","+std::to_string(slot*strides[axis]*width)+","+raw+"\n";LITERT_RETURN_IF_ERROR(write_bytes(row.data(),row.size()));}
+        else {Json cell={{"slot",slot},{"position",active?position:-1},{"active",active},{"hex",raw},{"sample_zero",zero},{"full",full},{"elements",wanted},{"byte_offset",slot*strides[axis]*width}};
+          if(full)cell["component_byte_offsets"]=std::move(offsets);tensor["samples"].push_back(std::move(cell));}
+      }
+    }
+    if(!layers.count(b.layer))layers[b.layer]={{"layer",b.layer},{"buffers",Json::array()}};
+    layers[b.layer]["buffers"].push_back(std::move(tensor));
+  }
+  if(kv_csv)return Json({{"exported",true},{"format",format},{"capture_ns",stamp}}).dump();
+  out["layers"]=Json::array();for(auto& layer:layers)out["layers"].push_back(std::move(layer.second));return out.dump();
+}
